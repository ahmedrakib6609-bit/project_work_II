<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Main ribbon background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/primaryColor" />
            <corners android:topLeftRadius="12dp" android:topRightRadius="12dp"
                android:bottomLeftRadius="12dp" android:bottomRightRadius="12dp" />
        </shape>
    </item>

    <!-- Ribbon corner triangle effect -->
    <item android:right="40dp">
        <rotate
            android:fromDegrees="45"
            android:pivotX="100%"
            android:pivotY="0%">
            <shape android:shape="rectangle">
                <solid android:color="@color/primaryDark" />
                <size
                    android:width="20dp"
                    android:height="20dp" />
            </shape>
        </rotate>
    </item>

    <!-- Ribbon folded corner effect -->
    <item android:right="40dp" android:top="0dp">
        <rotate
            android:fromDegrees="45"
            android:pivotX="100%"
            android:pivotY="0%">
            <shape android:shape="rectangle">
                <solid android:color="@color/primaryDark" />
                <size
                    android:width="25dp"
                    android:height="25dp" />
                <padding android:right="5dp" />
            </shape>
        </rotate>
    </item>

</layer-list>